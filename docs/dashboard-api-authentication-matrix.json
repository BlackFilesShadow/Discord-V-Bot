    "scope":  "API authentication matrix: session cookie, OAuth login/callback, auth middleware, unauthenticated/expired/revoked sessions, login/logout/status consistency between UI and API.",
    "contracts":  {
                      "v2Mount":  "v2Router.use(requireAuth) applies to every /api/v2 route before domain routers.",
                      "requireAuth":  "Missing userId/discordId =\u003e 401. userId/discordId without persistent sessionToken =\u003e 401 SESSION_REVOKED. Every supplied sessionToken must resolve to an active, unexpired, user-bound Prisma Session row; otherwise 401 SESSION_REVOKED + cookie destroyed.",
                      "oauth":  "Discord-only OAuth with state/nonce/PKCE; session.save before redirects.",
                      "logout":  "Deactivates Prisma Session.isActive, clears tokenCache, destroys express-session.",
                      "status":  "/auth/status returns authenticated false when DB session inactive/expired (UI source of truth).",
                      "apiMe":  "/api/me behind requireAuth â€” unauthenticated or unbound legacy cookie =\u003e 401.",
                      "publicExceptions":  "/auth/login|callback|status|logout paths; health/metrics/webhooks outside v2.",
                      "storeFailure":  "Session DB lookup failure =\u003e 503 SESSION_STORE_UNAVAILABLE fail-closed (no anonymous elevation)."
                  },
    "cases":  [
                  {

                      "scenario":  "No session cookie on /api/v2/*",
                      "expected":  "401 Nicht angemeldet",
                      "evidence":  "v2Router.use(requireAuth); tests/dashboard/api.test.ts",
                      "status":  "verified"
                  },
                  {

                      "expected":  "401 SESSION_REVOKED; cookie destroyed; no request reaches domain handlers",
                      "evidence":  "middleware/auth.ts requireAuth; tests/dashboard/requireAuthSessionGate.test.ts",
                      "status":  "fixed-stage-36-hardening"
                  },
                  {

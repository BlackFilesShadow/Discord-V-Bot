  "scope": "Dashboard list endpoints with pagination, search, filter, cursor or hard-cap windows. Stage 28 verifies deterministic ordering, tie-breakers, limit+1/hasMore (or total+hasMore for offset pages), filter/cursor consistency, empty results, duplicate/skip protection, and UI contract alignment.",
  "contracts": {
    "cursorAudit": "Canonical keyset cursor v1. + createdAt+id DESC with take limit+1, hasMore, nextCursor; legacy before rejected 400.",
    "offsetBotAdmin": "page/pageSize offset lists use strict integer validation, orderBy createdAt+id DESC, and response hasMore from total.",
    "hardCap": "Bounded windows use take limit+1 + hasMore and a deterministic secondary key; silent truncation without hasMore is forbidden for growing lists.",
    "exportStream": "Streaming exports may use Prisma id cursor pages with orderBy createdAt+id and hard caps; not UI infinite-scroll.",
    "scope": "Guild/slot scoped lists must re-bind scope on every page; cursor tampering cannot cross guild/slot.",
    "ui": "Filter changes reset cursor/pages; append uses applied filter snapshot; race uses request sequencing or queryKey."
  },

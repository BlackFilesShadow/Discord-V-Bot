model EconomyMarketDiscordProjection {
  id                  String   @id @default(cuid())
  guildId             String
  nitradoConnId       String
  catalogChannelId    String?
  directBuyEnabled    Boolean  @default(false)
  directBuyChannelId  String?
  orderChannelId      String?
  orderReadyChannelId String?
  lastSyncedAt        DateTime?
  lastSyncError       String?  @db.VarChar(500)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  messages            EconomyMarketDiscordMessage[]
  vendorCatalogs      EconomyMarketVendorCatalogProjection[]

  @@unique([guildId, nitradoConnId])
  @@unique([id, guildId, nitradoConnId], name: "idScope", map: "EconomyMarketDiscordProjection_id_scope_key")
  @@index([guildId, nitradoConnId])
}

model EconomyMarketDiscordMessage {
  id            String   @id @default(cuid())
  projectionId  String
  guildId       String
  nitradoConnId String
  kind          String   @db.VarChar(20)
  pageIndex     Int?
  listingId     String?
  channelId     String
  messageId     String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projection EconomyMarketDiscordProjection @relation(fields: [projectionId], references: [id], onDelete: Cascade)

  @@unique([projectionId, kind, pageIndex])
  @@unique([projectionId, kind, listingId])
  @@index([guildId, nitradoConnId, kind])
  @@index([listingId])
}

model EconomyMarketVendorCatalogProjection {
  id                   String   @id @default(cuid())
  projectionId         String
  guildId              String
  nitradoConnId        String
  vendorAccountId      String
  channelId            String
  catalogMessageId     String   @unique(map: "EconomyMarketVendorCatalogProjection_catalog_message_key")
  orderButtonMessageId String?  @unique(map: "EconomyMarketVendorCatalogProjection_order_message_key")
  currentPage          Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  projection EconomyMarketDiscordProjection @relation(fields: [projectionId, guildId, nitradoConnId], references: [id, guildId, nitradoConnId], onDelete: Cascade)

  @@unique([projectionId, vendorAccountId], name: "projectionVendor", map: "EconomyMarketVendorCatalogProjection_projection_vendor_key")
  @@index([guildId, nitradoConnId, vendorAccountId], map: "EconomyMarketVendorCatalogProjection_scope_vendor_idx")
}

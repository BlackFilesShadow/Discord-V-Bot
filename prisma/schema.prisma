// Prisma Schema für Discord-V-Bot
// Deckt alle Sektionen der README ab:
// 1. Registrierung & GUID-basierte Usertrennung
// 2. Upload- & Download-System
// 3. Download-System
// 4. Moderation, AI & Sicherheit
// 6. Giveaway-System
// 7. API-Integration & Web-Dashboard
// 8. Level- & XP-System
// 9. Automatische Rollenvergabe
// 10. Umfrage- & Abstimmungssystem
// 11. Logging & Analytics
// 12. Discord OAuth2-Organisation

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "debian-openssl-3.0.x"]
}

// Prisma 7: Connection-URL liegt in /prisma.config.ts (datasource.url).
// Schema-Block deklariert nur noch Provider.
datasource db {
  provider = "postgresql"
}

// ============================================================
// SEKTION 1: Registrierung & GUID-basierte Usertrennung
// ============================================================

model User {
  id                     String     @id @default(uuid()) // Kryptografisch sichere GUID (UUIDv4)
  discordId              String     @unique
  username               String
  discriminator          String     @default("")
  email                  String?
  role                   UserRole   @default(USER)
  status                 UserStatus @default(ACTIVE)
  isManufacturer         Boolean    @default(false)
  manufacturerApprovedAt DateTime?
  manufacturerApprovedBy String?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  // Relations
  packages            Package[]
  uploads             Upload[]
  downloads           Download[]
  moderationCases     ModerationCase[]     @relation("TargetUser")
  moderationActions   ModerationCase[]     @relation("ModeratorUser")
  appeals             Appeal[]
  giveawayEntries     GiveawayEntry[]
  giveawaysCreated    Giveaway[]
  xpRecords           XpRecord[]
  levelData           LevelData[]
  pollVotes           PollVote[]
  auditLogs           AuditLog[]           @relation("AuditUser")
  auditActions        AuditLog[]           @relation("AuditActor")
  sessions            Session[]
  oauthTokens         OAuthToken[]
  twoFactorAuth       TwoFactorAuth?
  manufacturerRequest ManufacturerRequest?
  oneTimePasswords    OneTimePassword[]
  roleAssignments     UserRoleAssignment[]
  inviteTracking      InviteTracking[]
  feedSubscriptions   FeedSubscription[]
  gdprConsent         GdprConsent?
  securityEvents      SecurityEvent[]      @relation("SecurityUser")
  apiKeys             ApiKey[]

  @@index([discordId])
  @@index([role])
  @@index([status])
}

enum UserRole {
  USER
  MANUFACTURER
  MODERATOR
  ADMIN
  SUPER_ADMIN
  DEVELOPER
  READ_ONLY
  CUSTOM
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
  SUSPENDED
  PENDING_VERIFICATION
}

model ManufacturerRequest {
  id         String        @id @default(uuid())
  userId     String        @unique
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     RequestStatus @default(PENDING)
  reason     String?
  adminNote  String?
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status])
}

enum RequestStatus {
  PENDING
  APPROVED
  DENIED
}

model OneTimePassword {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String
  expiresAt    DateTime
  usedAt       DateTime?
  isUsed       Boolean   @default(false)
  isRevoked    Boolean   @default(false)
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Package {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  status        PackageStatus @default(ACTIVE)
  isDeleted     Boolean       @default(false)
  deletedAt     DateTime?
  deletedBy     String?
  totalSize     BigInt        @default(0)
  fileCount     Int           @default(0)
  downloadCount Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  files         Upload[]
  downloads     Download[]
  validations   ValidationResult[]

  @@unique([userId, name])
  @@index([userId])
  @@index([status])
  @@index([isDeleted])
  @@index([name])
}

enum PackageStatus { ACTIVE QUARANTINED DELETED VALIDATING }

model Upload {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId        String
  package          Package          @relation(fields: [packageId], references: [id], onDelete: Cascade)
  fileName         String
  originalName     String
  filePath         String
  fileSize         BigInt
  mimeType         String
  fileHash         String
  fileType         FileType
  isValid          Boolean          @default(false)
  validationStatus ValidationStatus @default(PENDING)
  isQuarantined    Boolean          @default(false)
  quarantineReason String?
  isDeleted        Boolean          @default(false)
  deletedAt        DateTime?
  chunkCount       Int              @default(1)
  isChunked        Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  validations      ValidationResult[]
  downloadRecords  Download[]

  @@index([userId])
  @@index([packageId])
  @@index([fileType])
  @@index([validationStatus])
  @@index([isDeleted])
}

enum FileType { XML JSON OTHER }
enum ValidationStatus { PENDING VALID INVALID ERROR QUARANTINED }

model ValidationResult {
  id          String   @id @default(uuid())
  uploadId    String?
  upload      Upload?  @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  packageId   String?
  package     Package? @relation(fields: [packageId], references: [id], onDelete: Cascade)
  isValid     Boolean
  errors      Json?
  warnings    Json?
  suggestions Json?
  validatedBy String?
  createdAt   DateTime @default(now())

  @@index([uploadId])
  @@index([packageId])
}

model Download {
  id           String       @id @default(uuid())
  userId       String?
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  packageId    String?
  package      Package?     @relation(fields: [packageId], references: [id], onDelete: SetNull)
  uploadId     String?
  upload       Upload?      @relation(fields: [uploadId], references: [id], onDelete: SetNull)
  downloadType DownloadType
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime     @default(now())

  @@index([userId])
  @@index([packageId])
  @@index([uploadId])
  @@index([createdAt])
}

enum DownloadType { SINGLE_FILE PACKAGE_ZIP PACKAGE_TAR }

model ModerationCase {
  id              String           @id @default(uuid())
  caseNumber      Int              @unique @default(autoincrement())
  guildId         String?
  targetUserId    String
  targetUser      User             @relation("TargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  moderatorId     String
  moderator       User             @relation("ModeratorUser", fields: [moderatorId], references: [id], onDelete: Cascade)
  action          ModerationAction
  reason          String
  details         String?
  duration        Int?
  expiresAt       DateTime?
  escalationLevel Int              @default(0)
  isActive        Boolean          @default(true)
  revokedAt       DateTime?
  revokedBy       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  appeals         Appeal[]

  @@index([targetUserId])
  @@index([moderatorId])
  @@index([action])
  @@index([isActive])
  @@index([caseNumber])
  @@index([guildId])
}

enum ModerationAction { KICK BAN TEMP_BAN MUTE TEMP_MUTE WARN FILTER AUTO_MOD ESCALATION }

model Appeal {
  id         String         @id @default(uuid())
  caseId     String
  case       ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason     String
  status     AppealStatus   @default(PENDING)
  reviewedBy String?
  reviewNote String?
  reviewedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  @@index([caseId])
  @@index([userId])
  @@index([status])
}

enum AppealStatus { PENDING APPROVED DENIED ESCALATED }

model AutoModFilter {
  id         String           @id @default(uuid())
  guildId    String?
  pattern    String
  filterType FilterType
  action     ModerationAction @default(FILTER)
  severity   Int              @default(1)
  isActive   Boolean          @default(true)
  channelIds Json?
  createdBy  String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  @@index([filterType])
  @@index([isActive])
  @@index([guildId])
}

enum FilterType { KEYWORD REGEX LINK INVITE SPAM CAPS EMOJI_SPAM MENTION_SPAM CUSTOM }

model InviteTracking {
  id         String    @id @default(uuid())
  inviteCode String    @unique
  inviterId  String
  inviter    User      @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  usesCount  Int       @default(0)
  maxUses    Int?
  expiresAt  DateTime?
  channelId  String?
  createdAt  DateTime  @default(now())
  @@index([inviterId])
}

model AiAnalysis {
  id           String         @id @default(uuid())
  messageId    String
  channelId    String
  userId       String
  analysisType AiAnalysisType
  score        Float
  label        String?
  details      Json?
  actionTaken  String?
  createdAt    DateTime       @default(now())
  @@index([userId])
  @@index([analysisType])
  @@index([createdAt])
}

enum AiAnalysisType { SENTIMENT TOXICITY CONTEXT TRANSLATION KNOWLEDGE CUSTOM }

model Giveaway {
  id             String         @id @default(uuid())
  guildId        String?
  creatorId      String
  creator        User           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  channelId      String
  messageId      String?
  prize          String
  description    String?
  duration       Int
  endsAt         DateTime
  winnerId       String?
  winnerCount    Int            @default(1)
  status         GiveawayStatus @default(ACTIVE)
  minRole        String?
  blacklistRoles Json?
  customEmoji    String?
  notifyRoleId   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  entries        GiveawayEntry[]
  @@index([status])
  @@index([endsAt])
  @@index([channelId])
  @@index([guildId])
}

enum GiveawayStatus { ACTIVE ENDED CANCELLED REROLLED }

model GiveawayEntry {
  id         String   @id @default(uuid())
  giveawayId String
  giveaway   Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isWinner   Boolean  @default(false)
  enteredAt  DateTime @default(now())
  @@unique([giveawayId, userId])
  @@index([giveawayId])
  @@index([userId])
}

model LevelData {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guildId       String
  xp            BigInt    @default(0)
  level         Int       @default(0)
  totalMessages Int       @default(0)
  voiceMinutes  Int       @default(0)
  lastXpGain    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@unique([userId, guildId])
  @@index([guildId])
  @@index([level])
  @@index([xp])
}

model XpRecord {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  guildId     String
  amount      Int
  source      XpSource
  channelId   String?
  description String?
  createdAt   DateTime @default(now())
  @@index([userId])
  @@index([guildId])
  @@index([source])
  @@index([createdAt])
}

enum XpSource { MESSAGE VOICE EVENT REACTION BOOST ADMIN RESET CUSTOM }

model XpConfig {
  id                String   @id @default(uuid())
  messageXpMin      Int      @default(15)
  messageXpMax      Int      @default(25)
  voiceXpPerMinute  Int      @default(5)
  eventXpBonus      Int      @default(50)
  xpCooldownSeconds Int      @default(60)
  levelUpRoleIds    Json?
  levelMultiplier   Float    @default(1.0)
  isActive          Boolean  @default(true)
  allowedRoleIds    Json?
  allowedChannelIds Json?
  maxLevel          Int      @default(20)
  maxLevelRoleId    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model LevelReward {
  id        String   @id @default(uuid())
  level     Int      @unique
  roleId    String?
  reward    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  @@index([level])
}

model LevelRole {
  id        String   @id @default(uuid())
  guildId   String
  level     Int
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([guildId, level])
  @@index([guildId])
  @@index([roleId])
}

model LevelUpMessage {
  id        String   @id @default(uuid())
  guildId   String
  level     Int
  message   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([guildId, level])
  @@index([guildId])
}

model AutoRole {
  id             String          @id @default(uuid())
  guildId        String?
  roleId         String
  roleName       String
  triggerType    AutoRoleTrigger
  triggerValue   String?
  channelId      String?
  messageId      String?
  isActive       Boolean         @default(true)
  expiresAt      DateTime?
  blacklistRoles Json?
  whitelistRoles Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  @@index([guildId])
  @@index([triggerType])
  @@index([isActive])
}

enum AutoRoleTrigger { JOIN REACTION LEVEL ACTIVITY EVENT GIVEAWAY CUSTOM }

model UserRoleAssignment {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     String
  assignedBy String
  reason     String?
  expiresAt  DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  @@index([userId])
  @@index([roleId])
  @@index([isActive])
}

model Poll {
  id            String     @id @default(uuid())
  guildId       String?
  creatorId     String
  channelId     String
  messageId     String?
  title         String
  description   String?
  options       Json
  pollType      PollType   @default(PUBLIC)
  allowMultiple Boolean    @default(false)
  maxChoices    Int        @default(1)
  endsAt        DateTime?
  status        PollStatus @default(ACTIVE)
  totalVotes    Int        @default(0)
  results       Json?
  notifyRoleId  String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  votes         PollVote[]
  @@index([status])
  @@index([channelId])
  @@index([endsAt])
  @@index([guildId])
}

enum PollType { PUBLIC ANONYMOUS }
enum PollStatus { ACTIVE ENDED ARCHIVED }

model PollVote {
  id        String   @id @default(uuid())
  pollId    String
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  optionId  String
  createdAt DateTime @default(now())
  @@unique([pollId, userId, optionId])
  @@index([pollId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  deviceInfo   String?
  ipAddress    String?
  expiresAt    DateTime
  isActive     Boolean  @default(true)
  lastActivity DateTime @default(now())
  createdAt    DateTime @default(now())
  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@index([isActive])
}

model pg_simple_session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)
  @@index([expire], map: "IDX_session_expire")
  @@map("session")
  @@ignore
}

model OAuthToken {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokenEnc  String?
  refreshTokenEnc String?
  tokenType       String    @default("Bearer")
  scope           String
  expiresAt       DateTime
  lastRefresh     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  @@index([userId])
  @@index([expiresAt])
}

model TwoFactorAuth {
  id                  String    @id @default(uuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretEnc           String?
  isEnabled           Boolean   @default(false)
  backupCodes         Json?
  webauthnEnabled     Boolean   @default(false)
  webauthnCredentials Json?
  verifiedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model AuditLog {
  id          String        @id @default(uuid())
  actorId     String?
  actor       User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetId    String?
  target      User?         @relation("AuditUser", fields: [targetId], references: [id], onDelete: SetNull)
  action      String
  category    AuditCategory
  details     Json?
  ipAddress   String?
  userAgent   String?
  channelId   String?
  guildId     String?
  isImmutable Boolean       @default(true)
  createdAt   DateTime      @default(now())
  @@index([actorId])
  @@index([targetId])
  @@index([action])
  @@index([category])
  @@index([createdAt])
}

enum AuditCategory { AUTH REGISTRATION UPLOAD DOWNLOAD MODERATION GIVEAWAY LEVEL ROLE POLL SECURITY ADMIN SYSTEM CONFIG GDPR AI FEED TRANSLATE APPEAL TICKET NITRADO ECONOMY CASINO DASHBOARD WHITELIST FACTION SERVER_SETTINGS EMBED KILLFEED WELCOME }

model SecurityEvent {
  id          String            @id @default(uuid())
  userId      String?
  user        User?             @relation("SecurityUser", fields: [userId], references: [id], onDelete: SetNull)
  eventType   SecurityEventType
  severity    SecuritySeverity
  description String
  details     Json?
  ipAddress   String?
  userAgent   String?
  isResolved  Boolean           @default(false)
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime          @default(now())
  @@index([eventType])
  @@index([severity])
  @@index([userId])
  @@index([isResolved])
  @@index([createdAt])
}

enum SecurityEventType { LOGIN_FAILURE BRUTE_FORCE RATE_LIMIT_EXCEEDED SUSPICIOUS_ACTIVITY TOKEN_ABUSE UNAUTHORIZED_ACCESS DATA_BREACH_ATTEMPT MALWARE_DETECTED RAID_DETECTED SPAM_DETECTED IP_BLACKLISTED DEVICE_CHANGE PRIVILEGE_ESCALATION CUSTOM }
enum SecuritySeverity { LOW MEDIUM HIGH CRITICAL }

model IpList {
  id        String    @id @default(uuid())
  ipAddress String    @unique
  listType  ListType
  reason    String?
  addedBy   String
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  @@index([listType])
  @@index([ipAddress])
}

enum ListType { BLACKLIST WHITELIST }

model GdprConsent {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataProcessing Boolean   @default(false)
  analytics      Boolean   @default(false)
  marketing      Boolean   @default(false)
  consentVersion String    @default("1.0")
  ipAddress      String?
  consentedAt    DateTime  @default(now())
  withdrawnAt    DateTime?
  updatedAt      DateTime  @updatedAt
  @@index([userId])
}

model DataDeletionRequest {
  id          String         @id @default(uuid())
  userId      String
  discordId   String
  requestType DeletionType
  status      DeletionStatus @default(PENDING)
  scheduledAt DateTime
  completedAt DateTime?
  details     Json?
  createdAt   DateTime       @default(now())
  @@index([status])
  @@index([scheduledAt])
}

enum DeletionType { FULL_DELETION PARTIAL_DELETION DATA_EXPORT ANONYMIZATION }
enum DeletionStatus { PENDING IN_PROGRESS COMPLETED FAILED }

model Feed {
  id             String    @id @default(uuid())
  guildId        String?
  name           String
  feedType       FeedType
  url            String
  channelId      String
  interval       Int       @default(300)
  lastChecked    DateTime?
  lastItemId     String?
  isActive       Boolean   @default(true)
  filters        Json?
  mentionRoles   String[]  @default([])
  webhookSecret  String?
  credentialsEnc String?   @db.Text
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  subscriptions  FeedSubscription[]
  @@index([feedType])
  @@index([isActive])
  @@index([guildId])
}

enum FeedType { RSS TWITCH TWITTER STEAM NEWS YOUTUBE WEBHOOK CUSTOM }

model FeedSubscription {
  id        String   @id @default(uuid())
  feedId    String
  feed      Feed     @relation(fields: [feedId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifyDm  Boolean  @default(false)
  createdAt DateTime @default(now())
  @@unique([feedId, userId])
  @@index([feedId])
  @@index([userId])
}

model BotConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  category    String   @default("general")
  description String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([category])
  @@index([key])
}

model RateLimitEntry {
  id          String   @id @default(uuid())
  identifier  String
  action      String
  count       Int      @default(1)
  windowStart DateTime @default(now())
  expiresAt   DateTime
  @@unique([identifier, action])
  @@index([identifier])
  @@index([expiresAt])
}

model ApiKey {
  id          String    @id @default(uuid())
  userId      String
  name        String
  keyHash     String    @unique
  keyPrefix   String
  permissions Json      @default("[]")
  rateLimit   Int       @default(100)
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id])
  @@index([userId])
  @@index([keyHash])
  @@index([keyPrefix])
}

enum TicketStatus { PENDING OPEN DENIED CLOSED }

model Ticket {
  id               String          @id @default(uuid())
  ticketNumber     Int             @unique @default(autoincrement())
  userDiscordId    String
  username         String
  guildId          String?
  guildName        String?
  subject          String
  initialMessage   String          @db.Text
  status           TicketStatus    @default(PENDING)
  ownerDiscordId   String
  ownerNoticeMsgId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  closedAt         DateTime?
  messages         TicketMessage[]
  @@index([userDiscordId])
  @@index([status])
  @@index([ticketNumber])
}

model TicketMessage {
  id            String   @id @default(uuid())
  ticketId      String
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromDiscordId String
  fromRole      String
  content       String   @db.Text
  createdAt     DateTime @default(now())
  @@index([ticketId])
  @@index([createdAt])
}

model TicketTemplate {
  id                  String           @id @default(uuid())
  guildId             String
  slot                Int
  label               String
  buttonLabel         String?
  welcomeText         String           @db.Text
  welcomeMessages     Json             @default("[]")
  embedTitle          String
  embedDescription    String?          @db.Text
  embedColor          String           @default("#dc2626")
  postChannelId       String
  postedMessageId     String?
  categoryId          String?
  staffRoleId         String?
  managerRoleIds      String[]         @default([])
  mentionRoleIds      String[]         @default([])
  transcriptChannelId String
  archiveChannelId    String?
  isActive            Boolean          @default(true)
  ticketCounter       Int              @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  instances           TicketInstance[]

  processedByteOffset BigInt    @default(0)
  trailingPartialLine String?   @db.Text
  contentFingerprint  String?   @db.VarChar(64)
  lastSuccessAt       DateTime?
  lastError           String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  @@unique([guildId, nitradoConnId, fileIdentity])
  @@index([guildId, nitradoConnId])
}

enum AdmEventType { PLAYER_CONNECTED PLAYER_DISCONNECTED PLAYER_HIT PLAYER_KILLED PLAYER_DIED PLAYER_SUICIDE NPC_KILL VEHICLE_DEATH BUILD DISMANTLE DESTROY PLACEMENT PLAYER_POSITION UNKNOWN }

model AdmEvent {
  id              String       @id @default(cuid())
  eventKey        String       @unique @db.VarChar(64)
  guildId         String
  nitradoConnId   String
  sourceFile      String
  sourceByteStart BigInt
  sourceByteEnd   BigInt
  occurredAt      DateTime?
  eventType       AdmEventType
  actorGameId     String?
  actorName       String?
  targetGameId    String?
  targetName      String?
  objectType      String?
  toolOrWeapon    String?
  distanceMeters  Float?
  actorPosition   String?
  targetPosition  String?
  rawLine         String       @db.Text
  parserVersion   Int          @default(1)
  parseStatus     String
  createdAt       DateTime     @default(now())
  @@index([guildId, nitradoConnId, occurredAt])
  @@index([eventType, occurredAt])
}

enum RewardDecisionStatus { PENDING PAID SKIPPED REVIEW FAILED_RETRYABLE ERROR }

model RewardDecision {
  id            String               @id @default(cuid())
  admEventId    String
  rewardRuleId  String
  guildId       String
  nitradoConnId String
  userDiscordId String?
  status        RewardDecisionStatus @default(PENDING)
  calculated    BigInt               @default(0)
  paid          BigInt               @default(0)
  reasonCode    String?
  ledgerEntryId String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  @@unique([admEventId, rewardRuleId])
  @@index([guildId, nitradoConnId, status])
}

enum PlayerSessionStatus { OPEN CLOSED }

model PlayerSession {
  id                String              @id @default(cuid())
  guildId           String
  nitradoConnId     String
  gameId            String
  playerName        String?
  connectEventId    String              @unique
  disconnectEventId String?
  connectedAt       DateTime?
  disconnectedAt    DateTime?
  durationSeconds   Int                 @default(0)
  bucketsEarned     Int                 @default(0)
  bucketsCredited   Int                 @default(0)
  status            PlayerSessionStatus @default(OPEN)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  @@index([guildId, nitradoConnId, gameId])
  @@index([guildId, nitradoConnId, status])
}

enum NitradoSnapshotStatus { RUNNING OK PARTIAL FAILED }

model NitradoSnapshot {
  id              String                @id @default(cuid())
  guildId         String
  nitradoConnId   String
  nitradoConn     NitradoConnection     @relation(fields: [nitradoConnId], references: [id], onDelete: Cascade)
  serviceId       String?
  startedAt       DateTime              @default(now())
  finishedAt      DateTime?
  status          NitradoSnapshotStatus @default(RUNNING)
  totalFiles      Int                   @default(0)
  totalDirs       Int                   @default(0)
  totalBytes      BigInt                @default(0)
  storedBytes     BigInt                @default(0)
  oversizeFiles   Int                   @default(0)
  errorCount      Int                   @default(0)
  lastError       String?               @db.Text
  triggeredBy     String
  settingsJson    Json?
  serviceMetaJson Json?
  files           NitradoSnapshotFile[]
  @@index([guildId, nitradoConnId, startedAt])
  @@index([nitradoConnId, status])
}

model NitradoSnapshotFile {
  id          String          @id @default(cuid())
  snapshotId  String
  snapshot    NitradoSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  path        String          @db.VarChar(1024)
  name        String          @db.VarChar(512)
  parentDir   String          @db.VarChar(1024)
  isDir       Boolean         @default(false)
  sizeBytes   BigInt          @default(0)
  modifiedAt  DateTime?
  sha256      String?         @db.VarChar(64)
  mimeGuess   String?         @db.VarChar(120)
  isText      Boolean         @default(false)
  contentText String?         @db.Text
  storedPath  String?         @db.VarChar(512)
  oversize    Boolean         @default(false)
  errorMsg    String?         @db.Text
  @@index([snapshotId, parentDir])
  @@index([snapshotId, name])
  @@index([snapshotId, sha256])
}

enum KillCategory { DEATH SUICIDE NPC VEHICLE }

model KillfeedConfig {
  id                String            @id @default(cuid())
  guildId           String
  nitradoConnId     String
  nitradoConn       NitradoConnection @relation(fields: [nitradoConnId], references: [id], onDelete: Cascade)
  channelId         String            @db.VarChar(32)
  isActive          Boolean           @default(true)
  categories        KillCategory[]
  showShooterCoords Boolean           @default(false)
  showVictimCoords  Boolean           @default(true)
  showWeapon        Boolean           @default(true)
  showDistance      Boolean           @default(true)
  embedColor        String            @default("#dc2626") @db.VarChar(9)
  lastEventAt       DateTime?
  lastEtag          String?           @db.VarChar(128)
  lastFileName      String?           @db.VarChar(256)
  lastByteOffset    BigInt            @default(0)
  lastPolledAt      DateTime?
  lastErrorMsg      String?           @db.Text
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  @@unique([guildId, nitradoConnId, channelId])
  @@index([guildId, nitradoConnId])
  @@index([guildId, isActive])
}

model KillfeedEvent {
  id            String            @id @default(cuid())
  guildId       String
  nitradoConnId String
  nitradoConn   NitradoConnection @relation(fields: [nitradoConnId], references: [id], onDelete: Cascade)
  category      KillCategory
  occurredAt    DateTime
  shooterName   String?           @db.VarChar(120)
  shooterPos    String?           @db.VarChar(120)
  victimName    String            @db.VarChar(120)
  victimPos     String?           @db.VarChar(120)
  weapon        String?           @db.VarChar(120)
  distance      Float?
  rawLine       String            @db.Text
  postedAt      DateTime?
  createdAt     DateTime          @default(now())
  @@index([guildId, nitradoConnId, occurredAt])
  @@index([guildId, nitradoConnId, category])
}

model KillfeedDelivery {
  id          String   @id @default(cuid())
  configId    String
  admEventId  String
  guildId     String
  channelId   String   @db.VarChar(32)
  messageId   String?  @db.VarChar(32)
  deliveredAt DateTime @default(now())
  @@unique([configId, admEventId])
  @@index([guildId, admEventId])
}

// Mehrfach-Item-Bestellung: buendelt mehrere EconomyMarketPurchase-Zeilen
// (eine je gewaehltem Angebot) zu einer Bestellung mit Kanal-Embed und
// Abschluss-Workflow. Bestehende Einzelkauf-Zeilen bleiben orderId=null.
enum EconomyMarketOrderStatus {
  OPEN
  CLOSED
}

enum EconomyMarketOrderReadyNoticeStatus {
  PENDING
  SENDING
  SENT
}

model EconomyMarketOrder {
  id                String                   @id @default(cuid())
  guildId           String
  nitradoConnId     String
  vendorAccountId   String
  vendorAccount     EconomyVirtualAccount    @relation("MarketVendorOrders", fields: [vendorAccountId, guildId, nitradoConnId], references: [id, guildId, nitradoConnId], onDelete: Restrict, map: "EconomyMarketOrder_vendor_scope_fkey")
  userDiscordId     String
  totalAmount       BigInt
  status            EconomyMarketOrderStatus @default(OPEN)
  orderChannelId    String?
  orderMessageId    String?
  createdAt         DateTime                 @default(now())
  closedAt          DateTime?
  closedByDiscordId String?
  purchases         EconomyMarketPurchase[]
  readyNotice       EconomyMarketOrderReadyNotice?

  @@index([guildId, nitradoConnId, vendorAccountId, status], map: "EconomyMarketOrder_scope_status_idx")
  @@index([guildId, nitradoConnId, userDiscordId, createdAt], map: "EconomyMarketOrder_scope_user_created_idx")
}

// Persistenter Outbox- und Cleanup-Datensatz fuer die "Bestellung bereit"-
// Mention. PENDING/SENDING werden retryfaehig versendet; SENT wird nach der
// festgelegten Stunde restart-sicher geloescht.
model EconomyMarketOrderReadyNotice {
  id            String                              @id @default(cuid())
  orderId       String                              @unique
  order         EconomyMarketOrder                  @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "EconomyMarketOrderReadyNotice_order_fkey")
  guildId       String
  nitradoConnId String
  channelId     String?
  userDiscordId String
  messageId     String?
  status        EconomyMarketOrderReadyNoticeStatus @default(SENT)
  attempts      Int                                 @default(0)
  nextAttemptAt DateTime?
  leaseUntil    DateTime?
  lastError     String?
  sentAt        DateTime?
  deleteAt      DateTime?
  deletedAt     DateTime?
  createdAt     DateTime                            @default(now())

  @@index([status, nextAttemptAt, leaseUntil], map: "EconomyMarketOrderReadyNotice_send_due_idx")
  @@index([deletedAt, deleteAt], map: "EconomyMarketOrderReadyNotice_pending_idx")
  @@index([guildId, nitradoConnId], map: "EconomyMarketOrderReadyNotice_scope_idx")
}

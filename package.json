{
  "name": "discord-v-bot",
  "version": "1.0.0",
  "description": "V-Bot Prime: Discord-, Community- und DayZ/Nitrado-Bot mit AI, Hersteller-Workflows und getrenntem Guild-/Bot-Admin-/DEV-Dashboard",
  "main": "dist/src/index.js",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "npm run build:ui && tsc",
    "build:ui": "cd dashboard-ui && npm run build",
    "build:server": "tsc",
    "ui:install": "cd dashboard-ui && npm install",
    "ui:dev": "cd dashboard-ui && npm run dev",
    "start": "node dist/src/index.js",
    "dev": "ts-node src/index.ts",
    "dev:watch": "nodemon --exec ts-node src/index.ts",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:ui": "cd dashboard-ui && npm run lint",
    "lint:all": "npm run lint && npm run lint:ui",
    "test": "jest --coverage",
    "test:ci": "jest --coverage --ci",
    "test:handles": "jest --detectOpenHandles --runInBand --coverage=false",
    "test:watch": "jest --watch",
    "test:local-ci": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-ci-parity.ps1",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts",
    "db:consistency": "ts-node src/scripts/dbConsistencyScan.ts",
    "db:lifecycle": "node -e \"const {resolveBash}=require('./scripts/resolve-bash'); const b=resolveBash(); if(!b){console.error('bash missing'); process.exit(1)}; const r=require('child_process').spawnSync(b,['deploy/db-lifecycle-verify.sh'],{stdio:'inherit'}); process.exit(r.status==null?1:r.status)\"",
    "db:test-up": "docker compose -f docker-compose.test.yml up -d --wait",
    "deploy-commands": "ts-node src/commands/deploy.ts",
    "clear-commands": "ts-node src/commands/clear.ts",
    "dashboard": "ts-node src/dashboard/server.ts",
    "loadtest": "ts-node scripts/loadtest.ts",
    "perf:baselines-46-48": "node scripts/runtime-baselines-46-48.mjs",
    "perf:series-46-49": "node --expose-gc scripts/runtime-series-46-49.mjs",
    "perf:load": "node scripts/perf-load-inprocess.mjs",
    "perf:soak": "node scripts/soak-test-smoke.mjs",
    "perf:chaos": "node scripts/chaos-smoke.mjs",
    "audit:sync": "node scripts/sync-masterplan-audit.mjs",
    "audit:check": "node scripts/sync-masterplan-audit.mjs --check",
    "smoke": "bash deploy/smoke.sh"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "ajv": "^8.17.1",
    "archiver": "^7.0.1",
    "argon2": "^0.41.1",
    "axios": "^1.7.7",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "cron": "^3.1.7",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.1",
    "fast-xml-parser": "^5.11.0",
    "helmet": "^8.0.0",
    "jsonschema": "^1.4.1",
    "multer": "^2.2.0",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "redis": "^4.7.1",
    "rss-parser": "^3.13.0",
    "socket.io": "^4.8.3",
    "speakeasy": "^2.0.0",
    "unzipper": "^0.12.3",
    "winston": "^3.15.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.19.17",
    "@types/pg": "^8.20.0",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "eslint": "^9.14.0",
    "jest": "^29.7.0",
    "nanoid": "^5.1.9",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}

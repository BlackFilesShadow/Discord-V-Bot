# =============================================
# Discord-V-Bot Konfiguration
# =============================================
#
# HINWEIS: Alle mit "your_..."/"changeme" markierten Werte sind PLATZHALTER und
# NICHT produktionsfaehig. In Production (NODE_ENV=production) bricht der Start
# ab, solange ein Pflicht-Secret noch einen Platzhalterwert traegt.

# Discord Bot
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_GUILD_ID=your_guild_id_here
# Kanonische globale Owner-ID. DISCORD_OWNER_ID ist nur noch ein kontrollierter
# Legacy-Alias und sollte in neuen Installationen NICHT mehr gesetzt werden.
BOT_OWNER_ID=your_discord_user_id_here

# Datenbank (PostgreSQL)
# Bei Docker-Compose: postgres als Hostname; ansonsten localhost o.ae.
# WICHTIG: "changeme" ist nur fuer lokale Entwicklung. In Production wird ein
# DATABASE_URL mit "changeme" beim Start abgelehnt.
DATABASE_URL=postgresql://discordbot:changeme@postgres:5432/discord_v_bot?schema=public

# Postgres-Credentials (von docker-compose.yml verwendet)
POSTGRES_DB=discord_v_bot
POSTGRES_USER=discordbot
POSTGRES_PASSWORD=changeme

# Web-Dashboard
DASHBOARD_PORT=3000
DASHBOARD_URL=http://localhost:3000
SESSION_SECRET=your_session_secret_here_min_64_chars
OAUTH2_REDIRECT_URI=http://localhost:3000/auth/callback
TRUST_PROXY=1

# Sicherheit
ADMIN_PASSWORD_HASH=
TWO_FACTOR_ISSUER=Discord-V-Bot
ENCRYPTION_KEY=your_32_byte_encryption_key_hex

# Developer-Bereich
# Rechte entstehen NUR aus BOT_OWNER_ID + aktueller DB-Rolle DEVELOPER.
# DEV_PASSWORD ist ausschliesslich Step-up und darf keine Identitaet erzeugen.
DEV_PASSWORD=change_me_to_a_long_random_secret
DEV_REQUIRE_MFA=false
DEV_REQUIRE_IP_ALLOWLIST=false
DEV_IP_ALLOWLIST=

# Bot-Admin-Bereich
# Rechte entstehen aus globaler Bot-Admin-Identitaet; das Passwort ist nur Step-up.
# In Production MUSS ein eigener zufaelliger Wert gesetzt sein.
BOT_ADMIN_PASSWORD=change_me_to_a_different_long_random_secret

# Member-Erfassung
MEMBER_SYNC_ENABLED=false
MEMBER_SYNC_INTERVAL_HOURS=12

# Nitrado-Schreibschutz: Standard AN.
NITRADO_WRITE_PROTECTION=true

# ADM-/Gameplay-Feed-V2
# Der per-Server ADM-V2-Ingest sowie der Gameplay-Feed-Worker laufen immer.
# Discord-Ausgaben entstehen nur fuer explizit konfigurierte und aktive
# GameplayFeedConfig-Eintraege pro Guild + Gameserver + Channel. Es gibt kein
# zusaetzliches globales Feed-Gate mehr.

# ADM-Verzeichnisse werden ausschliesslich pro Nitrado-Connection automatisch
# erkannt oder ueber die ADM-Source-Konfiguration gesetzt. Es gibt keinen
# globalen NITRADO_ADM_DIR mehr.

# Upload-System
UPLOAD_DIR=./uploads
PRIVATE_UPLOAD_DIR=./private
DEV_UPLOAD_DIR=./private/dev-logs
EXPORT_DIR=./private/exports
MAX_FILE_SIZE_BYTES=26214400
ALLOWED_EXTENSIONS=.xml,.json

# AI-Integration (mindestens einen Provider konfigurieren)
# Provider-Prioritaet: groq | cerebras | openrouter | gemini | openai
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# Externe APIs (optional)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITTER_BEARER_TOKEN=
STEAM_API_KEY=
YOUTUBE_API_KEY=

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Monitoring
# Sicherer Default: deaktiviert. Fuer /metrics muessen BEIDE Werte gesetzt sein.
# METRICS_TOKEN sollte mindestens 32 zufaellige Zeichen besitzen.
METRICS_ENABLED=false
METRICS_TOKEN=
ERROR_WEBHOOK_URL=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Redis Response-Cache (Docker-Compose setzt standardmaessig den internen Redis).
REDIS_URL=redis://redis:6379

# WICHTIG: ALLOW_BASELINE_ADOPTION gehoert NICHT dauerhaft in .env.
# Falls eine alte Bestands-DB ohne Baseline-Eintrag einmalig adoptiert werden
# muss, wird der Wert nur fuer genau diesen kontrollierten Deploy-Lauf gesetzt:
#   ALLOW_BASELINE_ADOPTION=true sudo -E bash deploy/update.sh
# Das Script prueft zusaetzlich mehrere Schema-Sentinels und bricht sonst ab.